/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* -- Greenscreen compact layout for narrow outputs -- */
/* -- used by GenerateWaybarGreenscreen.sh -- */

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"name": "greenscreen-narrow",
"layer": "top",
"exclusive": true,
"passthrough": false,
"position": "top",
"spacing": 0,
"fixed-center": true,
"ipc": true,
"margin-top": 2,
"margin-left": 4,
"margin-right": 4,

"modules-left": [
  "custom/phalanx",
  "custom/separator#blank_tight",
  "hyprland/workspaces#rw",
  "custom/add_workspace",
  "custom/separator#blank_1",
  "group/greenscreen-notify"
],
"modules-center": [
  "clock#forest_compact"
],
"modules-right": [
  "group/greenscreen-status",
  "custom/separator#blank_1",
  "group/greenscreen-brightness",
  "custom/separator#blank_1",
  "group/audio"
],

"group/notify": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 500,
    "children-class": "custom/swaync",
    "transition-left-to-right": true
  },
  "modules": [
    "custom/swaync",
    "custom/settings",
    "custom/tty",
    "custom/file_manager",
    "custom/browser",
    "custom/cycle_wall",
    "custom/power",
    "custom/lock",
    "custom/hypridle"
  ]
},

"group/greenscreen-notify": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 350,
    "children-class": "custom/swaync",
    "transition-left-to-right": true
  },
  "modules": [
    "custom/swaync",
    "custom/nightlight",
    "tray"
  ]
},

"group/greenscreen-status": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 350,
    "children-class": "memory",
    "transition-left-to-right": false
  },
  "modules": [
    "group/mem_temp",
    "cpu#forest_narrow",
    "group/network_stack",
    "disk#forest_narrow"
  ]
},

// Handle for the stats drawer — both memory and temperature are visible by
// default so hovering either triggers the drawer expansion.
"group/mem_temp": {
  "orientation": "inherit",
  "modules": [
    "memory#forest_narrow",
    "temperature#forest_narrow"
  ]
},

"group/greenscreen-brightness": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 350,
    "children-class": "backlight",
    "transition-left-to-right": false
  },
  "modules": [
    "battery#forest_narrow",
    "backlight"
  ]
},

"group/network_stack": {
  "orientation": "vertical",
  "modules": [
    "custom/network_up",
    "custom/network_down"
  ]
},

"custom/network_up": {
  "exec": "$HOME/.config/hypr/scripts/NetworkBandwidth.sh --up",
  "interval": 1,
  "format": "{}",
  "tooltip": false
},

"custom/network_down": {
  "exec": "$HOME/.config/hypr/scripts/NetworkBandwidth.sh --down",
  "interval": 1,
  "format": "{}",
  "tooltip": false
},

"pulseaudio": {
  "format": "{icon} {volume}%",
  "format-bluetooth": "{icon} 󰂰 {volume}%",
  "format-muted": "󰖁",
  "format-icons": {
    "headphone": "",
    "hands-free": "",
    "headset": "",
    "phone": "",
    "portable": "",
    "car": "",
    "default": ["", "", "󰕾", ""]
  },
  "scroll-step": 5.0,
  "on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
  "on-click-right": "pavucontrol -t 3",
  "on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
  "on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
  "tooltip-format": " {desc} | {volume}%",
  "smooth-scrolling-threshold": 1
},
"custom/phalanx": {
      "format":" 󱚝",
      "tooltip": true,
      "on-click": "$HOME/.config/hypr/scripts/RofiLauncher.sh",
      "on-click-middle": "pkill rofi || rofi -show drun -modi run,drun,filebrowser,window",
      "tooltip-format": "Left Click: Launcher menu\nMiddle Click: Unified Rofi launcher"
},
"custom/add_workspace": {
      "format": "󰐕",
      "tooltip": true,
      "tooltip-format": "Add a new workspace to this display",
      "on-click": "$HOME/.config/hypr/scripts/AddWorkspace.sh __WAYBAR_MONITOR__"
},
"custom/current_workspace": {
      "return-type": "json",
      "exec": "$HOME/.config/hypr/scripts/WorkspacePicker.sh --current __WAYBAR_MONITOR__",
      "interval": 1,
      "on-click": "$HOME/.config/hypr/scripts/WorkspacePicker.sh pick __WAYBAR_MONITOR__",
      "tooltip": true
},
"custom/status_cap": {
  "format": " ",
  "interval": "once",
  "tooltip": false
},
"custom/status_left_cap": {
  "format": " ",
  "interval": "once",
  "tooltip": false
},
"custom/status_left_cap_narrow": {
  "format": " ",
  "interval": "once",
  "tooltip": false
},
"custom/audio_left_cap_narrow": {
  "format": " ",
  "interval": "once",
  "tooltip": false
},
"custom/notify_cap_narrow": {
  "format": " ",
  "interval": "once",
  "tooltip": false
},
"clock#forest_compact": {
      "format": "{:%a %d.%b.%Y - %H:%M}",
      "tooltip-format": "<span color='#00bb00' size='larger'>{:%Y %B}</span>\n<tt>{calendar}</tt>",
      "calendar": {
          "mode": "month",
          "weeks-pos": "right",
          "on-scroll": 1,
          "format": {
              "months": "<span color='#00dd00'><b>{}</b></span>",
              "days": "<span color='#00bb00'>{}</span>",
              "weeks": "<span color='#007700'><b>W{:%V}</b></span>",
              "weekdays": "<span color='#00ff00'><b>{}</b></span>",
              "today": "<span color='#00ff00'><b><u>{}</u></b></span>"
          }
      },
      "on-scroll": {
                  "calendar": 1
                   }
},
"battery#forest_narrow": {
  "align": 0,
  "rotate": 0,
  "full-at": 100,
  "design-capacity": false,
  "states": {
    "good": 95,
    "warning": 30,
    "critical": 15
  },
  "format": "{icon} {capacity}%",
  "format-charging": "{icon}  {capacity}%",
  "format-plugged": "󱘖 {capacity}%",
  "format-alt-click": "click",
  "format-full": "{icon} Full",
  "format-alt": "{icon} {time}",
  "format-icons": [
    "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
  ],
  "format-time": "{H}h {M}m",
  "tooltip": true,
  "tooltip-format": "{timeTo} {power}w",
  "on-click-middle": "$HOME/.config/hypr/scripts/ChangeBlur.sh",
  "on-click-right": "$HOME/.config/hypr/scripts/Wlogout.sh"
},
"cpu#forest_narrow": {
  "format": "󰍛 {usage}%",
  "interval": 1,
  "min-length": 0,
  "format-alt-click": "click",
  "format-alt": "{icon0}{icon1}{icon2}{icon3} {usage:>2}%",
  "format-icons": [
    "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"
  ],
  "on-click-right": "gnome-system-monitor"
},
"disk#forest_narrow": {
  "interval": 30,
  "path": "/home/",
  "format": "󰋊 {free}",
  "on-click-right": "baobab"
},
"memory#forest_narrow": {
  "interval": 10,
  "format": "󰾆 {used:0.1f}G",
  "format-alt": "{percentage}%",
  "format-alt-click": "click",
  "tooltip": true,
  "tooltip-format": "Ram {used:0.1f}GB/{total:0.1f}G",
  "on-click-right": "kitty --title btop sh -c 'btop'"
},
"network#speed_narrow": {
  "interval": 1,
  "format-wifi": "󰤨 {signalStrength}%",
  "format-ethernet": "󰈀 {bandwidthUpBytes}  {bandwidthDownBytes}",
  "format-linked": "{ifname} (No IP) ",
  "format-disconnected": "󰖪",
  "tooltip-format": "{ifname} via {gwaddr}",
  "tooltip-format-wifi": "{essid} ({signalStrength}%)",
  "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
  "tooltip-format-disconnected": "Disconnected",
  "max-length": 22
},
"temperature#forest_narrow": {
  "interval": 10,
  "tooltip": true,
  "hwmon-path": [
    "/sys/class/hwmon/hwmon11/temp1_input"
  ],
  "critical-threshold": 82,
  "format-critical": "{temperatureC}°C",
  "format": "{temperatureC}°C",
  "format-icons": [
    "󰈸"
  ],
  "on-click-right": "kitty --title nvtop sh -c 'nvtop'"
}
}
