// ### Greenscreen ### //

{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesCustom",
  "$HOME/.config/waybar/ModulesGroups",
  "$HOME/.config/waybar/UserModules",
  ],
"name": "greenscreen-wide",
"layer": "top",
//"mode": "dock",
"exclusive": true,
"passthrough": false,
"position": "top",
//"spacing": 6,
"fixed-center": true,
"ipc": true,
//"margin-top": 3,
//"margin-left": 8,
//"margin-right": 8,

"modules-left": [
  "custom/phalanx",
	"custom/separator#blank_tight",
	"hyprland/workspaces#rw",
	"custom/add_workspace",
	"custom/separator#blank_2",
//	"mpris",
	"group/greenscreen-notify",
	],
"modules-center": [
	"clock#forest",
	],
"modules-right": [
	"group/greenscreen-stats",
	"custom/separator#blank_2",
	"group/greenscreen-brightness",
	"custom/separator#blank_2",
	"group/audio",
	],

// Parked: launcher drawer (settings/tty/etc.). Not referenced in modules-* yet —
// will be re-wired into the bar at a different location in a later change.
"group/notify": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 500,
		"children-class": "custom/swaync",
		"transition-left-to-right": true
	},
	"modules": [
		"custom/swaync",
		"custom/settings",
		"custom/tty",
		"custom/file_manager",
		"custom/browser",
		"custom/cycle_wall",
		"custom/power",
		"custom/lock",
		"custom/hypridle"
	]
},

"group/greenscreen-notify": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 350,
		"children-class": "custom/swaync",
		"transition-left-to-right": true
	},
	"modules": [
		"custom/swaync",
		"custom/nightlight",
		"tray"
	]
},

"group/greenscreen-stats": {
	"orientation": "inherit",
	"modules": [
		"cpu#forest",
		"memory#forest",
		"group/network_stack",
		"temperature#forest",
		"disk#forest"
	]
},

"group/greenscreen-brightness": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 350,
		"children-class": "backlight",
		"transition-left-to-right": false
	},
	"modules": [
		"custom/uconsole-battery#forest",
		"backlight"
	]
},

// Additional / Edited Waybar Modules //
"pulseaudio": {
	"format": "  {volume}%",
	"format-bluetooth": " 󰂰  {volume}%",
	"format-muted": "󰖁",
	"scroll-step": 5.0,
	"on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
	"on-click-right": "pavucontrol -t 3",
	"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
	"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
	"tooltip-format": " {desc} | {volume}%",
	"smooth-scrolling-threshold": 1
},
"custom/phalanx": {
      "format":" 󱚝",
      "tooltip": true,
      "on-click": "$HOME/.config/hypr/scripts/RofiLauncher.sh",
      "on-click-middle": "pkill rofi || rofi -show drun -modi run,drun,filebrowser,window",
      "tooltip-format": "Left Click: Launcher menu\nMiddle Click: Unified Rofi launcher"
},
"custom/add_workspace": {
      "format": "󰐕",
      "tooltip": true,
      "tooltip-format": "Add a new workspace to this display",
      "on-click": "$HOME/.config/hypr/scripts/AddWorkspace.sh __WAYBAR_MONITOR__"
},
"clock#forest": {
      "format": "{:%A %d.%b.%Y - %H:%M}",
      "tooltip-format": "<span color='#00bb00' size='larger'>{:%Y %B}</span>\n<tt>{calendar}</tt>",
      "calendar": {
          "mode": "month",
          "weeks-pos": "right",
          "on-scroll": 1,
          "format": {
              "months": "<span color='#00dd00'><b>{}</b></span>",
              "days": "<span color='#00bb00'>{}</span>",
              "weeks": "<span color='#007700'><b>W{:%V}</b></span>",
              "weekdays": "<span color='#00ff00'><b>{}</b></span>",
              "today": "<span color='#00ff00'><b><u>{}</u></b></span>"
          }
      },
      "on-scroll": {
                  "calendar": 1
                   }
},
"custom/uconsole-battery#forest": {
	// AXP223 kernel capacity register is stuck at 100%; use the
	// voltage-based gauge (uconsole-tweaks: /usr/local/bin/uconsole-battery).
	// Icon is picked from format-icons by the JSON `percentage`; the
	// tooltip and CSS class (charging/warning/critical/...) come from
	// the script, so #custom-uconsole-battery mirrors the #battery CSS.
	"exec": "/usr/local/bin/uconsole-battery",
	"return-type": "json",
	"interval": 30,
	"format": "{icon}  {}",
	"format-icons": [
		"󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
	],
	"tooltip": true,
	"on-click-middle": "$HOME/.config/hypr/scripts/ChangeBlur.sh",
	"on-click-right": "$HOME/.config/hypr/scripts/Wlogout.sh",
},

"cpu#forest": {
	"format": "󰍛  {usage:>2}%",
	"interval": 1,
	"min-length": 5,
	"format-alt-click": "click",
	"format-alt": "{icon0}{icon1}{icon2}{icon3} {usage:>2}% 󰍛",
	"format-icons": [
		"▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"
	],
	"on-click-right": "gnome-system-monitor",
},

"disk#forest": {
	"interval": 30,
	//"format": "Disk    󰋊",
	"path": "/home/",
	//"format-alt-click": "click",
	"format": "󰋊  {free}",
  "on-click-right": "baobab",
//	"tooltip": true,
//	"tooltip-format": "Disk    {used} used out of {total} on {path} ({percentage_used}%)",
},

"memory#forest": {
	"interval": 10,
	"format": "󰾆  {used:0.1f}G",
	"format-alt": "󰾆  {percentage}%",
	"format-alt-click": "click",
	"tooltip": true,
	"tooltip-format": "Ram    {used:0.1f}GB/{total:0.1f}G",
	"on-click-right": "kitty --title btop sh -c 'btop'"
},
"temperature#forest": {
	"interval": 10,
	"tooltip": true,
	"hwmon-path": [
		"/sys/class/hwmon/hwmon11/temp1_input"
	],
	//"thermal-zone": 0,
	"critical-threshold": 82,
	"format-critical": "{icon}  {temperatureC}°C",
	"format": "{icon}  {temperatureC}°C",
	"format-icons": [
		" 󰈸"
	],
	"on-click-right": "kitty --title nvtop sh -c 'nvtop'"
},
"custom/network_up": {
	"exec": "$HOME/.config/hypr/scripts/NetworkBandwidth.sh --up",
	"interval": 1,
	"format": "{}",
	"tooltip": false
},
"custom/network_down": {
	"exec": "$HOME/.config/hypr/scripts/NetworkBandwidth.sh --down",
	"interval": 1,
	"format": "{}",
	"tooltip": false
},
"group/network_stack": {
	"orientation": "vertical",
	"modules": [
		"custom/network_up",
		"custom/network_down"
	]
}
}
