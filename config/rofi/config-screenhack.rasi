/* ---- 💫 https://github.com/LinuxBeginnings 💫 ---- */
/* Screensaver hack picker (SUPER SHIFT L) - see ScreenHackSelect.sh */

@import "~/.config/rofi/config.rasi"


/* ---- Mainbox ---- */
mainbox {
  children:
    [ "inputbar", "message", "listview"];
}

/* ---- Entry ---- */
entry {
  expand: true;
  placeholder: " 🖥️ Search Screensaver Hacks";
}

/* ---- Listview ---- */
listview {
  columns: 3;
  lines: 12;
  fixed-height: false;
  scrollbar: true;
  spacing: 6px;
  cycle: true;
}

window {
  width: 60%;
  height: inherit;
}

/* ---- Elements ---- */
element {
  orientation: horizontal;
}

element-icon {
  size: 0%;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    margin: 0px;
    padding: 0px;
}
